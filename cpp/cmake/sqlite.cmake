include(FetchContent)
set(ANTWORLD_SQLITE_ARCHIVE "" CACHE FILEPATH "Optional verified SQLite 3.54.1 archive for offline builds")
set(sqlite_url "https://sqlite.org/2026/sqlite-amalgamation-3540100.zip")
if(ANTWORLD_SQLITE_ARCHIVE)
    set(sqlite_url "${ANTWORLD_SQLITE_ARCHIVE}")
elseif(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/../.tools/sqlite/sqlite-amalgamation-3540100.zip")
    set(sqlite_url "${CMAKE_CURRENT_SOURCE_DIR}/../.tools/sqlite/sqlite-amalgamation-3540100.zip")
endif()
FetchContent_Declare(sqlite
    URL "${sqlite_url}"
    URL_HASH SHA256=0a9c8e34352dad46006aa82836d5383bff9dc6bc9ce5a60553c05aa30e6ad1f9
    DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
FetchContent_MakeAvailable(sqlite)
add_library(antworld_sqlite STATIC "${sqlite_SOURCE_DIR}/sqlite3.c")
target_include_directories(antworld_sqlite PUBLIC "${sqlite_SOURCE_DIR}")
target_compile_definitions(antworld_sqlite PRIVATE SQLITE_THREADSAFE=1 SQLITE_OMIT_LOAD_EXTENSION SQLITE_DQS=0)
if(UNIX)
    find_package(Threads REQUIRED)
    target_link_libraries(antworld_sqlite PRIVATE Threads::Threads ${CMAKE_DL_LIBS} m)
endif()
if(ANTWORLD_SANITIZERS AND NOT MSVC)
    target_compile_options(antworld_sqlite PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
    target_link_options(antworld_sqlite PRIVATE -fsanitize=address,undefined)
endif()
