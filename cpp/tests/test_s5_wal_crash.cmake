set(path "${OUTPUT_DIR}/wal-crash.sqlite")
execute_process(COMMAND "${TEST}" SEED "${path}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "WAL crash seed failed")
endif()
execute_process(COMMAND "${TEST}" CRASH "${path}" RESULT_VARIABLE result)
if(NOT result EQUAL 78)
    message(FATAL_ERROR "No physical WAL write crash: ${result}")
endif()
execute_process(COMMAND "${TEST}" VERIFY "${path}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Incomplete WAL transaction became authoritative")
endif()
