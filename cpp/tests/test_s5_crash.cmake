foreach(stage RANGE 0 4)
    set(path "${OUTPUT_DIR}/crash-${stage}.sqlite")
    execute_process(COMMAND "${TEST}" CRASH_SEED "${path}" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Crash fixture initialization failed")
    endif()
    execute_process(COMMAND "${TEST}" "CRASH_${stage}" "${path}" RESULT_VARIABLE result)
    if(NOT result EQUAL 77)
        message(FATAL_ERROR "Child did not terminate at the requested crash boundary: ${result}")
    endif()
    if(stage EQUAL 4)
        set(expected CRASH_NEW)
    else()
        set(expected CRASH_OLD)
    endif()
    execute_process(COMMAND "${TEST}" "${expected}" "${path}" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Recovery of interrupted generation failed")
    endif()
endforeach()
