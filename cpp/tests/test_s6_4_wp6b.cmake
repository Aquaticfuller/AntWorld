set(output "${ROOT}/FND_${MODE}")
file(MAKE_DIRECTORY "${output}")
foreach(database exact legacy fault)
    file(REMOVE "${output}/${database}.sqlite" "${output}/${database}.sqlite-wal" "${output}/${database}.sqlite-shm")
endforeach()
execute_process(COMMAND "${TEST}" "${MODE}" "${output}" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "FND_${MODE} failed with ${status}")
endif()
