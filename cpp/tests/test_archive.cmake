file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(database "${OUTPUT_DIR}/archive.sqlite")
# Remove only these test-owned files; never recursively delete a caller directory.
file(REMOVE "${database}" "${database}-wal" "${database}-shm")
execute_process(COMMAND "${CLI}" create "${database}" "${SCENARIO}" RESULT_VARIABLE status OUTPUT_VARIABLE created)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Archive create failed")
endif()
string(JSON world GET "${created}" world_id)
string(JSON initial_time GET "${created}" time_ms)
if(NOT initial_time EQUAL 60000)
    message(FATAL_ERROR "Scenario observation time was not persisted")
endif()
execute_process(COMMAND "${CLI}" inspect "${database}" "${world}" RESULT_VARIABLE status OUTPUT_VARIABLE inspected)
if(NOT status EQUAL 0 OR NOT inspected STREQUAL created)
    message(FATAL_ERROR "Archive inspection differs from saved state")
endif()
execute_process(COMMAND "${CLI}" advance "${database}" "${world}" 120000 RESULT_VARIABLE status OUTPUT_VARIABLE advanced)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Archive continuation failed")
endif()
string(JSON time GET "${advanced}" time_ms)
string(JSON generation GET "${advanced}" generation)
if(NOT time EQUAL 120000 OR NOT generation EQUAL 2)
    message(FATAL_ERROR "Wrong durable continuation boundary")
endif()
execute_process(COMMAND "${CLI}" advance "${database}" "${world}" 119999 RESULT_VARIABLE status ERROR_QUIET)
if(status EQUAL 0)
    message(FATAL_ERROR "Archive rewound committed history")
endif()
execute_process(COMMAND "${CLI}" create "${database}" "${SCENARIO}" RESULT_VARIABLE status ERROR_QUIET)
if(status EQUAL 0)
    message(FATAL_ERROR "Create overwrote an existing world")
endif()
execute_process(COMMAND "${CLI}" inspect "${database}" "${world}" RESULT_VARIABLE status OUTPUT_VARIABLE inspected)
if(NOT status EQUAL 0 OR NOT inspected STREQUAL advanced)
    message(FATAL_ERROR "Rejected archive operation changed saved world")
endif()
