string(RANDOM LENGTH 12 ALPHABET "0123456789abcdef" nonce)
set(output "${ROOT}/wp5-${MODE}-${nonce}")
if(MODE STREQUAL "founder-on")
    set(args founding on 0 7)
elseif(MODE STREQUAL "founder-off")
    set(args founding off 0 7)
elseif(MODE STREQUAL "compact")
    set(args excavation compact 32 7)
elseif(MODE STREQUAL "isolated" OR MODE STREQUAL "shielded")
    set(args excavation ${MODE} 8 7)
elseif(MODE STREQUAL "joint")
    set(args joint depot 8 7)
elseif(MODE STREQUAL "gate")
    set(args gate reopen 2 1)
else()
    message(FATAL_ERROR "Unknown WP-5 case")
endif()
execute_process(COMMAND "${CLI}" "${output}" ${args} RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "WP-5 ${MODE} failed")
endif()
file(STRINGS "${output}/summary.csv" result REGEX "^PASS,")
file(STRINGS "${output}/edits.csv" edits REGEX "^[0-9]")
if(NOT result OR ((MODE STREQUAL "gate" OR MODE STREQUAL "compact") AND NOT edits))
    message(FATAL_ERROR "WP-5 missing verified result")
endif()
if((MODE STREQUAL "isolated" OR MODE STREQUAL "shielded") AND edits)
    message(FATAL_ERROR "WP-5 negative excavation control made an edit")
endif()
file(REAL_PATH "${ROOT}" root_path)
file(REAL_PATH "${output}" output_path)
cmake_path(IS_PREFIX root_path "${output_path}" NORMALIZE inside)
if(inside AND NOT output_path STREQUAL root_path)
    file(REMOVE_RECURSE "${output_path}")
else()
    message(FATAL_ERROR "Unexpected WP-5 scratch path")
endif()
