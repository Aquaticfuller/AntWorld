string(RANDOM LENGTH 12 ALPHABET "0123456789abcdef" nonce)
set(output "${ROOT}/wp3-${MODE}-${nonce}")
if(MODE STREQUAL "factorial")
    set(args factorial near present 1 fresh 7)
elseif(MODE STREQUAL "scout")
    set(args scout near blind 0 expired 19)
elseif(MODE STREQUAL "density")
    set(args density dense32 present 0 fresh 42)
elseif(MODE STREQUAL "wall")
    set(args disruption wall absent 1 fresh 43)
elseif(MODE STREQUAL "deplete")
    set(args disruption deplete absent 1 fresh 7)
elseif(MODE STREQUAL "prepared")
    set(args prepared straight present 0 fresh 97)
else()
    message(FATAL_ERROR "Unknown WP-3 test")
endif()
execute_process(COMMAND "${CLI}" "${output}" ${args} RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "WP-3 ${MODE} failed")
endif()
file(REAL_PATH "${ROOT}" root_path)
file(REAL_PATH "${output}" output_path)
cmake_path(IS_PREFIX root_path "${output_path}" NORMALIZE inside)
if(inside AND NOT output_path STREQUAL root_path)
    file(REMOVE_RECURSE "${output_path}")
else()
    message(FATAL_ERROR "Unexpected WP-3 scratch path")
endif()
