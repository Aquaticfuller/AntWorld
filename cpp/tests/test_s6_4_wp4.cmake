string(RANDOM LENGTH 12 ALPHABET "0123456789abcdef" nonce)
set(output "${ROOT}/wp4-${MODE}-${nonce}")
if(MODE STREQUAL "adverse-clock")
    set(args clock funded 0 borisovka 1)
elseif(MODE STREQUAL "sentinel")
    set(args clock sentinel 0 st-petersburg 1)
elseif(MODE STREQUAL "energy-tie")
    set(args clock energy-tie 0 borisovka 1)
elseif(MODE STREQUAL "water-tie")
    set(args clock water-tie 0 legacy 1)
elseif(MODE STREQUAL "interrupted")
    set(args clock interrupted 0 legacy 1)
elseif(MODE STREQUAL "pulse-before")
    set(args pulse before 1 legacy 1)
elseif(MODE STREQUAL "pulse-on")
    set(args pulse on 1 legacy 1)
elseif(MODE STREQUAL "brood")
    set(args brood full 3 legacy 1)
elseif(MODE STREQUAL "founders")
    set(args ecology empty 0 legacy 43)
else()
    message(FATAL_ERROR "Unknown WP-4 test")
endif()
execute_process(COMMAND "${CLI}" "${output}" ${args} RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "WP-4 ${MODE} failed")
endif()
file(STRINGS "${output}/summary.csv" result REGEX "^PASS,")
if(NOT result)
    message(FATAL_ERROR "WP-4 missing verified result")
endif()
file(REAL_PATH "${ROOT}" root_path)
file(REAL_PATH "${output}" output_path)
cmake_path(IS_PREFIX root_path "${output_path}" NORMALIZE inside)
if(inside AND NOT output_path STREQUAL root_path)
    file(REMOVE_RECURSE "${output_path}")
else()
    message(FATAL_ERROR "Unexpected WP-4 scratch path")
endif()
