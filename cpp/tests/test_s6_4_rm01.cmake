string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
set(path "${ROOT}/rm01-${MODE}-${nonce}")

function(check_arm profile arm)
    execute_process(COMMAND "${CLI}" "${path}/${profile}-${arm}" "${profile}" "${arm}" 1
                    RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "RM-01 ${profile} ${arm} failed")
    endif()
endfunction()

if(MODE STREQUAL "short")
    foreach(profile legacy borisovka st-petersburg)
        foreach(arm seed funded sentinel)
            check_arm(${profile} ${arm})
        endforeach()
    endforeach()
    check_arm(borisovka energy-tie)
    check_arm(st-petersburg energy-tie)
    check_arm(legacy water-tie)
    check_arm(legacy interrupted)
elseif(MODE STREQUAL "legacy")
    check_arm(legacy depot-8)
elseif(MODE STREQUAL "warm")
    check_arm(borisovka ordinary-32)
else()
    message(FATAL_ERROR "Unknown RM-01 test mode")
endif()
