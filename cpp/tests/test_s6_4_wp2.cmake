string(RANDOM LENGTH 12 ALPHABET "0123456789abcdef" nonce)
set(output "${ROOT}/wp2-${MODE}-${nonce}")
if(MODE STREQUAL "b01")
    set(args b01 no_brood 0 7 plain 0 own)
elseif(MODE STREQUAL "b02")
    set(args b02 trio 3 19 wall 6 foreign)
elseif(MODE STREQUAL "integrated")
    set(args integrated care 4 7 underground 4 balanced)
elseif(MODE STREQUAL "activity")
    set(args activity ordinary 8 1 ordinary 0 balanced)
else()
    message(FATAL_ERROR "Unknown WP-2 test")
endif()
execute_process(COMMAND "${CLI}" "${output}" ${args} RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "WP-2 ${MODE} failed")
endif()
file(REAL_PATH "${ROOT}" root_path)
file(REAL_PATH "${output}" output_path)
cmake_path(IS_PREFIX root_path "${output_path}" NORMALIZE inside)
if(inside AND NOT output_path STREQUAL root_path)
    file(REMOVE_RECURSE "${output_path}")
else()
    message(FATAL_ERROR "Unexpected WP-2 scratch path")
endif()
