string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
set(path "${ROOT}/s634-${MODE}-${nonce}")
if(MODE STREQUAL "CRASH")
    file(MAKE_DIRECTORY "${path}")
    foreach(stage 5 6 7 8 3 4)
        set(database "${path}/boundary-${stage}.sqlite")
        execute_process(COMMAND "${CLI}" SEED "${database}" RESULT_VARIABLE result)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Cannot create crash seed")
        endif()
        execute_process(COMMAND "${CLI}" "EXIT_${stage}" "${database}" RESULT_VARIABLE result)
        if(NOT result EQUAL 77)
            message(FATAL_ERROR "Child failed to exit at boundary ${stage}")
        endif()
        if(stage EQUAL 4)
            set(expected NEW)
        else()
            set(expected OLD)
        endif()
        message(STATUS "Process terminated at save boundary ${stage}, expected ${expected}")
        execute_process(COMMAND "${CLI}" "${expected}" "${database}" RESULT_VARIABLE result)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Crash at boundary ${stage} did not recover exactly")
        endif()
    endforeach()
elseif(MODE STREQUAL "custody" OR MODE STREQUAL "connectivity")
    execute_process(COMMAND "${CLI}" "${path}" "${MODE}" SEGMENTED RESULT_VARIABLE result)
elseif(MODE STREQUAL "ECO_SMOKE")
    execute_process(COMMAND "${CLI}" "${path}" ecology-4-balanced-care 7 RESULT_VARIABLE result)
else()
    execute_process(COMMAND "${CLI}" "${MODE}" "${path}" RESULT_VARIABLE result)
endif()
if(NOT result EQUAL 0)
    message(FATAL_ERROR "S6.3.4 ${MODE} failed")
endif()
