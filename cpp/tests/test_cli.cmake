file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(diagnostic_count 8)
if(MODE STREQUAL "T11")
    set(diagnostic_count 0)
endif()
execute_process(COMMAND "${CLI}" --scenario "${SCENARIO}" --advance-ms 60000
    --diagnostic-events ${diagnostic_count} --output "${OUTPUT_DIR}/first.json"
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "CLI failed: ${result}: ${stderr}")
endif()
file(READ "${OUTPUT_DIR}/first.json" first)
if(NOT first STREQUAL stdout)
    message(FATAL_ERROR "stdout and JSON output differ")
endif()
foreach(field world_id status scope rng_version schema_version physics_version hash_version state_hash trace_hash)
    string(JSON value ERROR_VARIABLE error GET "${first}" ${field})
    if(error OR value STREQUAL "")
        message(FATAL_ERROR "Missing/invalid JSON field: ${field}")
    endif()
endforeach()
string(JSON time GET "${first}" sim_time_ms)
string(JSON count GET "${first}" committed_events)
if(NOT time EQUAL 60000 OR NOT count EQUAL diagnostic_count)
    message(FATAL_ERROR "Wrong CLI time/event count")
endif()
if(MODE STREQUAL "T13")
    execute_process(COMMAND "${CLI}" --scenario "${SCENARIO}" --advance-ms 60000
        --diagnostic-events 8 --output "${OUTPUT_DIR}/second.json" RESULT_VARIABLE result OUTPUT_VARIABLE second)
    if(NOT result EQUAL 0 OR NOT first STREQUAL second)
        message(FATAL_ERROR "Repeated CLI run is not reproducible")
    endif()
    string(FIND "${first}" "${OUTPUT_DIR}" leaked)
    if(NOT leaked EQUAL -1)
        message(FATAL_ERROR "Output embeds a machine-dependent path")
    endif()
elseif(MODE STREQUAL "CLI_VALIDATION")
    file(READ "${SCENARIO}" scenario)
    foreach(kind unknown nested duplicate fractional_seed overflow negative unit bounds nonempty type)
        set(bad "${scenario}")
        if(kind STREQUAL "unknown")
            string(JSON bad SET "${bad}" unexpected 1)
        elseif(kind STREQUAL "nested")
            string(JSON bad SET "${bad}" world bounds_m unexpected 1)
        elseif(kind STREQUAL "duplicate")
            string(REPLACE "\"seed\": 12345" "\"seed\": 12345, \"seed\": 9" bad "${bad}")
        elseif(kind STREQUAL "fractional_seed")
            string(REPLACE "\"seed\": 12345" "\"seed\": 1.5" bad "${bad}")
        elseif(kind STREQUAL "overflow")
            string(REPLACE "\"seed\": 12345" "\"seed\": 18446744073709551616" bad "${bad}")
        elseif(kind STREQUAL "negative")
            string(JSON bad SET "${bad}" requested_observation_ms -1)
        elseif(kind STREQUAL "unit")
            string(JSON bad SET "${bad}" world time_unit "\"seconds\"")
        elseif(kind STREQUAL "bounds")
            string(JSON bad SET "${bad}" world bounds_m x_min 2)
        elseif(kind STREQUAL "nonempty")
            string(JSON bad SET "${bad}" colonies "[{}]")
        elseif(kind STREQUAL "type")
            string(JSON bad SET "${bad}" status true)
        endif()
        file(WRITE "${OUTPUT_DIR}/${kind}.json" "${bad}")
        execute_process(COMMAND "${CLI}" --scenario "${OUTPUT_DIR}/${kind}.json"
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic)
        if(NOT result EQUAL 2 OR NOT diagnostic MATCHES "ERROR:")
            message(FATAL_ERROR "Invalid scenario ${kind} was not rejected: ${result}: ${diagnostic}")
        endif()
    endforeach()
    execute_process(COMMAND "${CLI}" --scenario "${SCENARIO}" --advance-ms -1 RESULT_VARIABLE result ERROR_VARIABLE diagnostic)
    if(NOT result EQUAL 2)
        message(FATAL_ERROR "Negative CLI target accepted")
    endif()
endif()
message(STATUS "PASS ${MODE}")
